{
  "name": "momentum",
  "productName": "Momentum",
  "version": "2.4.13",
  "description": "Momentum \u2014 all-in-one productivity planner (desktop app)",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --mac zip dmg --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.quantumshadow911.momentum",
    "productName": "Momentum",
    "files": [
      "main.js",
      "offline.html"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "../icons/icon-512.png",
      "identity": null
    },
    "electronLanguages": [
      "en"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
